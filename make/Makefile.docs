# Makefile.docs - Documentation and tool related tasks
# Contains documentation generation, update and maintenance related tasks

.PHONY: doc update-vul-table update-readme update-modules-json

# High-level documentation entrypoint
doc:
	@echo "Updating project documentation (README.md, vulnerability table, and modules.json)..."
	@$(MAKE) update-readme
	@$(MAKE) update-modules-json

update-vul-table:
	@echo "Updating vulnerability table in README.md from vul/README.md..."
	@python3 script/update_vul_table.py

update-readme:
	@echo "Updating README.md (command help sections and vulnerability table)..."
	@python3 script/update_readme.py

update-modules-json:
	@echo "Updating modules.json from registered CLI commands..."
	@go run ./script/update_modules_json.go
